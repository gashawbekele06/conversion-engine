# Kill switch — DEFAULT UNSET routes all outbound to staff sink.
# Do NOT set this to 1 without program-staff review.
# TENACIOUS_LIVE=1

# LLM tier: dev | eval
LLM_TIER=dev
LLM_MODEL_DEV=qwen/qwen3-next-80b-a3b
LLM_MODEL_EVAL=anthropic/claude-sonnet-4.6

# OpenRouter (primary LLM gateway)
# OPENROUTER_API_KEY=

# Email providers (either is fine)
# RESEND_API_KEY=
# MAILERSEND_API_KEY=

# ── PATH A: Real Gmail Reply Detection (no custom domain required) ──────────
# Uses Gmail plus-addressing:  yourname+tenacious@gmail.com routes to the same
# inbox as yourname@gmail.com — zero DNS configuration needed.
#
# Setup steps (one-time, ~5 min):
#   1. Set TENACIOUS_REPLY_TO to a Gmail plus-address for your sink account.
#      Example: if STAFF_SINK_EMAIL=you@gmail.com use:
#        TENACIOUS_REPLY_TO=you+tenacious@gmail.com
#   2. Enable 2-Step Verification on your Google Account (required for App Passwords).
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create an App Password for  App: Mail  /  Device: Other (name: tenacious)
#   5. Copy the 16-character code into GMAIL_IMAP_APP_PASSWORD below.
#
# How it works:
#   The pipeline sets Reply-To: TENACIOUS_REPLY_TO on outbound emails.
#   When you (or the prospect) clicks Reply in Gmail, the reply goes TO the
#   plus address.  The IMAP poller detects it as UNSEEN+TO:plus-address,
#   classifies the body, and fires the registered reply handlers —
#   exactly as if Resend had POSTed to /webhooks/email.
#   Cal.com books → HubSpot updates → journey advances to 'booked'.
#
# TENACIOUS_REPLY_TO=you+tenacious@gmail.com
# GMAIL_IMAP_USER=you@gmail.com
# GMAIL_IMAP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── PATH B: Resend custom domain inbound (requires DNS delegation) ───────────
# Set TENACIOUS_REPLY_TO to an address on your Resend-inbound domain, e.g.
# replies@yourdomain.com, and configure Resend to POST inbound mail to
# https://<your-host>/webhooks/email.  PATH B requires a public server URL.
# TENACIOUS_REPLY_TO=replies@yourdomain.com

# Africa's Talking (SMS sandbox)
# AT_USERNAME=sandbox
# AT_API_KEY=

# HubSpot Developer Sandbox (MCP)
# HUBSPOT_TOKEN=

# Cal.com self-hosted
# CALCOM_API_KEY=

# Langfuse
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Staff sinks (overrides defaults)
STAFF_SINK_EMAIL=challenge-sink@tenacious.internal
STAFF_SINK_SMS=+10000000000
